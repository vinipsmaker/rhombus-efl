  efl_gfx_entity_size_get
  efl_gfx_entity_geometry_set
  efl_gfx_entity_geometry_get
  efl_gfx_entity_visible_set
  efl_gfx_entity_visible_get
  efl_gfx_entity_scale_set
  efl_gfx_entity_scale_get
